# ── Database ────────────────────────────────────────────────────────────────
# The API MUST connect as a non-owner role (erp_app), or Postgres row-level
# security is bypassed and every branch-scoping policy becomes decorative.
# db/schema.sql creates this role and grants it what it needs.
DATABASE_URL=postgres://erp_app:erp_app_password@localhost:5432/erp

# The role that OWNS the tables, used only to apply db/schema.sql and db/seed.sql.
MIGRATION_DATABASE_URL=postgres://erp:erp_dev_password@localhost:5432/erp

# ── API ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# Signs session tokens. REQUIRED in production, minimum 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_MINUTES=720

# ── Auth (Section 7.2) ──────────────────────────────────────────────────────
# Leave blank to disable Google sign-in; email + password and phone + PIN still work.
GOOGLE_OAUTH_CLIENT_ID=
OTP_EXPIRY_MINUTES=5
RESET_EXPIRY_MINUTES=30

# ── WhatsApp Cloud API (requirement #4, Sections 6.2, 11.1, 14) ─────────────
# Without these the message queue still fills and drains; messages are marked
# sent in development instead of being delivered.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
