# ── Database ────────────────────────────────────────────────────────────────
# The API MUST connect as a non-owner role (erp_app), or Postgres row-level
# security is bypassed and every branch-scoping policy becomes decorative.
# db/schema.sql creates this role and grants it what it needs.
DATABASE_URL=postgres://erp_app:erp_app_password@localhost:5432/erp

# The role that OWNS the tables, used only to apply db/schema.sql and db/seed.sql.
MIGRATION_DATABASE_URL=postgres://erp:erp_dev_password@localhost:5432/erp

# ── API ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# Signs session tokens. REQUIRED in production, minimum 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_MINUTES=720

# ── Auth (Section 7.2) ──────────────────────────────────────────────────────
# Google sign-in: the OAuth "Web application" client ID. Set it here (API) only —
# the sign-in screen reads it from the API. Blank = no Google button.
GOOGLE_OAUTH_CLIENT_ID=
OTP_EXPIRY_MINUTES=5
RESET_EXPIRY_MINUTES=30

# ── Email (sign-in codes, password reset links) — optional ──────────────────
# One of the two keys, plus MAIL_FROM. Without them the sign-in screen does not
# offer "Email code" or "Forgot password" (codes that cannot arrive are not offered).
#   Gmail  — sends as your own Gmail account over HTTPS (no SMTP): GMAIL_CLIENT_SECRET +
#            GMAIL_REFRESH_TOKEN (client ID reuses GOOGLE_OAUTH_CLIENT_ID). See docs/OPERATIONS.md.
#   Brevo  — sends from one verified address (a Gmail is fine); free 300/day.
#   Resend — needs your own verified domain.
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM="Bhawani Hardware <you@gmail.com>"
# The web app's address, for links in emails. Defaults to the first CORS origin.
APP_URL=

# ── WhatsApp Cloud API (optional) ───────────────────────────────────────────
# WhatsApp is never required. Bills, receipts and statements are shared from the
# screen with a "Share on WhatsApp" link that opens WhatsApp for a person to send.
# Only when these are set are QUEUED messages (reminders the owner chose to send,
# or bills if "Queue bills and credit notes for WhatsApp automatically" is turned
# on in Admin → Settings) delivered through the WhatsApp Business API. Without
# them, queued messages are closed as NOT_CONFIGURED — never reported as sent.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: older deployments set the Google client ID here too; the API's
# GOOGLE_OAUTH_CLIENT_ID is enough now.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Time zone ───────────────────────────────────────────────────────────────
# The business day (which day a bill belongs to, "today" on reports, document
# dates) is reckoned in this IANA time zone, on the server and in the browser.
BUSINESS_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_BUSINESS_TIMEZONE=Asia/Kolkata

# ── Backups (npm run backup / npm run backup:restore-test) ─────────────────
# Uses MIGRATION_DATABASE_URL. See docs/OPERATIONS.md.
BACKUP_DIR=./backups
BACKUP_KEEP=14
# A connection allowed to CREATE/DROP DATABASE, for the restore test's scratch copy.
RESTORE_ADMIN_URL=
